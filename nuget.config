<?xml version="1.0" encoding="utf-8"?>
<!--
  Sample NuGet.config for restoring CPOSPS and its Microsoft Dynamics Commerce SDK dependencies.

  Consumers MUST add the Dynamics 365 Commerce private feed (and authenticate) to restore
  Microsoft.Dynamics.Commerce.* packages. CPOSPS does NOT redistribute those DLLs.

  Feed (official partner registry):
    https://pkgs.dev.azure.com/commerce-partner/Registry/_packaging/dynamics365-commerce/nuget/v3/index.json

  Authenticate with Azure Artifacts / Visual Studio / `az artifacts` as required by your org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="dynamics365-commerce" value="https://pkgs.dev.azure.com/commerce-partner/Registry/_packaging/dynamics365-commerce/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dynamics365-commerce">
      <package pattern="Microsoft.Dynamics.Commerce.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
