{
  "manifest_version": 3,
  "name": "CPOSPS",
  "version": "1.0.0",
  "description": "CPOSPS — Chrome POS Peripheral Simulator side panel for Hardware Station PosTerminal API.",
  "permissions": ["sidePanel", "storage"],
  "commands": {
    "open-pos-devices": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Open CPOSPS side panel"
    }
  },
  "host_permissions": [
    "https://localhost:450/*",
    "http://localhost:450/*",
    "https://127.0.0.1:450/*",
    "http://127.0.0.1:450/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CPOSPS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
